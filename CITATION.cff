cff-version: 1.2.0
message: >
  If you use this manuscript-rendering code in your research, please cite it
  using the metadata below.

title: >
  pad-amp-nhd-val-report: Manuscript Report Renderer for the External Validation
  of Three Published Integer Risk Scores for Non-Home Discharge After Major Lower
  Extremity Amputation

authors:
  - given-names: "Adam P."
    family-names: "Johnson"
    name-suffix: "MD, MPH"
    affiliation: "Duke University School of Medicine, Department of Surgery; Durham VA Medical Center"
    orcid: "https://orcid.org/0000-0002-3014-6372"
